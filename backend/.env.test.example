# Database Configuration (Test Environment)
DB_NAME=test_inventory_db
DB_USER=postgres
DB_PASSWORD=your_test_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET=test_jwt_secret_key
JWT_EXPIRES_IN=1h

# Environment Configuration
NODE_ENV=test

# API Configuration
PORT=3002
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=error

# Test Configuration
TEST_TIMEOUT=30000
