# Database Configuration
DB_NAME=credisa_inventory
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Environment Configuration
NODE_ENV=development

# API Configuration
PORT=3001
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
